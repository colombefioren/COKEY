# COKEY example environment file.
#
# Copy to .env and fill in as needed. COKEY never writes secrets to .env for
# you, and never uploads anything: every value here stays on this machine.
#
# Credentials may be referenced from a chain definition by environment variable
# name, so a key never has to be pasted into the UI on headless machines:
#
#   credentials:
#     - description: Main Groq
#       env: GROQ_KEY_1
#
# Examples from the provider catalog:

GROQ_KEY_1=
GROQ_KEY_2=
OPENROUTER_KEY_1=
GEMINI_KEY_1=
CLOUDFLARE_KEY_1=
CLOUDFLARE_ACCOUNT_ID=

# Gateway overrides (all optional).
COKEY_PORT=8787
COKEY_HOST=127.0.0.1
COKEY_DATA_DIR=
COKEY_LOG_LEVEL=info
# COKEY_AUTH_TOKEN=change-me

# Curated content repository (provider dossiers, terms, ranking boards).
#
# The content lives in its own Git repository so that editing a dossier or a
# ranking does not mean shipping a build. Point this at that checkout to serve
# it; leave it unset and COKEY looks for ./cms/content and then
# ../cokey-cms/content, falling back to the catalog compiled into this build.
# COKEY_CMS_DIR=../cokey-cms/content
