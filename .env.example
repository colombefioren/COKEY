# COKEY example environment file.
#
# Copy to .env and fill in as needed. COKEY never writes secrets to .env for
# you, and never uploads anything: every value here stays on this machine.
#
# Credentials may be referenced from a chain definition by environment variable
# name, so a key never has to be pasted into the UI on headless machines:
#
#   credentials:
#     - description: Main Groq
#       env: GROQ_KEY_1
#
# Examples from the provider catalog:

GROQ_KEY_1=
GROQ_KEY_2=
OPENROUTER_KEY_1=
GEMINI_KEY_1=
CLOUDFLARE_KEY_1=
CLOUDFLARE_ACCOUNT_ID=

# Gateway overrides (all optional).
COKEY_PORT=8787
COKEY_HOST=127.0.0.1
COKEY_DATA_DIR=
COKEY_LOG_LEVEL=info
# COKEY_AUTH_TOKEN=change-me

# Published ranking bundle (used only by the "check for updates" button on
# the Rankings screen — never fetched automatically, never on startup).
# The default points at COKEY--RANKINGS's rankings.json, which only works once
# that repository is public; while it stays private this 404s harmlessly and
# the compiled boards keep serving. Point this at your own public copy to use
# the feature sooner.
# COKEY_RANKINGS_URL=https://raw.githubusercontent.com/colombefioren/COKEY--RANKINGS/main/content/rankings.json
